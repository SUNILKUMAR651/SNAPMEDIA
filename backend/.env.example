# Backend Port (Render automatically sets PORT=10000)
PORT=5000
NODE_ENV=production

# Binary Paths (Auto-detected in Docker / System PATH)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg

# YouTube Anti-Bot Cookie Support (MANDATORY on Cloud Servers like Render, AWS, VPS)
# Export cookies from Chrome/Firefox using extension "Get cookies.txt LOCALLY"
# Option A: Paste the raw text or base64 encoded cookie content here
# YOUTUBE_COOKIES=your_cookies_txt_content_or_base64
# Option B: Put cookies.txt in the backend folder and set path:
# YOUTUBE_COOKIE_PATH=./cookies.txt

# Optional Proxy (HTTP / SOCKS5) to bypass datacenter IP restrictions
# PROXY_URL=http://user:password@proxy_host:port

