# Application Environment Configuration
PORT=3000
NODE_ENV=production

# Optional Separate Backend URL (for Render / VPS / Docker deployment)
# If left empty, Next.js internal /api routes are used.
# NEXT_PUBLIC_BACKEND_URL=https://your-backend-api.onrender.com

# Binary Paths (Optional, automatically detected if installed in system PATH)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg

# YouTube Anti-Bot & Cloud Server Cookie Support (Crucial for Cloud Datacenters like Render/AWS/VPS)
# You can supply either a file path to cookies.txt or the raw cookie content / base64 string
# YOUTUBE_COOKIE_PATH=/path/to/cookies.txt
# YOUTUBE_COOKIES=your_cookies_txt_content_or_base64

# Optional Proxy URL (HTTP/HTTPS/SOCKS5)
# PROXY_URL=http://user:password@proxy_host:port

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
